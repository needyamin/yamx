# API keys for each provider
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-key-here
OPENROUTER_API_KEY=your-key-here

# Kimi / Moonshot (base_url https://api.moonshot.ai/v1 — either env name works)
MOONSHOT_API_KEY=your-key-here
# KIMI_API_KEY=your-key-here

# xAI Grok (OpenAI-compatible chat at https://api.x.ai/v1)
XAI_API_KEY=xai-your-key-here

# Default provider and model (override config.json)
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=deepseek-chat

# Get keys at:
# OpenAI:      https://platform.openai.com/api-keys
# Anthropic:   https://console.anthropic.com/settings/keys
# Gemini:      https://aistudio.google.com/apikey
# Kimi/Moonshot: https://platform.kimi.ai/console/api-keys (MOONSHOT_API_KEY or KIMI_API_KEY)
# xAI Grok:    https://console.x.ai/team/default/api-keys
# OpenRouter:  https://openrouter.ai/keys
