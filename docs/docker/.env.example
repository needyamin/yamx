# Copy to .env next to docker-compose.yml and adjust.
#
# Default compose uses qwen2.5-coder:3b so ~8 GiB machines can run without Ollama's
# "requires more system memory" error. For Gemma 4 E4B you need roughly 10+ GiB free
# RAM for inference — set OLLAMA_MODEL=gemma4:e4b only when the host can spare it.
#
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_MODEL=gemma4:e2b
# OLLAMA_MODEL=llama3.2:3b

OLLAMA_MODEL=qwen2.5-coder:3b

# Optional: if ollama-init keeps failing mid-pull (slow or flaky network)
# OLLAMA_INIT_PULL_RETRIES=12
# OLLAMA_INIT_PULL_RETRY_SECONDS=45
# OLLAMA_INIT_START_DELAY=10
