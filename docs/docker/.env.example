# Copy to .env next to docker-compose.yml and adjust.
#
# Default compose uses qwen2.5:1.5b — small RAM/CPU footprint vs Gemma or larger Qwen tags.
# Upgrade in .env when you have spare RAM, e.g.:
#   OLLAMA_MODEL=qwen2.5-coder:3b   (better for code)
#   OLLAMA_MODEL=qwen2.5:3b         (general, heavier than 1.5b)
# Gemma 4 E4B needs a lot of RAM (~10+ GiB for inference is common); avoid on tight machines.
#
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_MODEL=gemma4:e2b
# OLLAMA_MODEL=qwen2.5-coder:3b
# OLLAMA_MODEL=llama3.2:3b

OLLAMA_MODEL=qwen2.5:1.5b

# Optional: if ollama-init keeps failing mid-pull (slow or flaky network)
# OLLAMA_INIT_PULL_RETRIES=12
# OLLAMA_INIT_PULL_RETRY_SECONDS=45
# OLLAMA_INIT_START_DELAY=10
